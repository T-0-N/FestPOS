<?xml version="1.0" encoding="utf-8"?>
<!-- FestPOS Tap: von der Bestell-App (Fully) über intent://pay#Intent;scheme=festpostap;… gestartet, ruft die
     Payrexx-App (Tap to Pay, NFC) auf und meldet das Ergebnis an den Pi. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="io.github.payrexx.taptopay" />
        <intent><action android:name="com.payrexx.taptopay.SOFTPOS" /></intent>
    </queries>
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".TapActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="festpostap" android:host="pay" />
            </intent-filter>
        </activity>
    </application>
</manifest>
