<?xml version="1.0" encoding="utf-8"?>
<!-- Der Pi hat ein Zertifikat der FestPOS-CA (auf jedem Handy als Benutzer-Zertifikat installiert, ANLEITUNG Schritt 4).
     Nur https, kein Klartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
