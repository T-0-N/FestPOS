# rqlite für den Pi (linux-arm64): feste Version mit Prüfsumme. Gelesen von setup.sh, update.sh (install-lib.sh) und
# tools/pakete.py (legt die Datei ins Update-Paket und ins Image). Andere Version nur zusammen mit ihrer SHA256 und
# nur innerhalb derselben Hauptversion (v10.x): ein Update spielt sie Pi für Pi ein, der druckende zuletzt.
RQLITE_VERSION=v10.5.3
RQLITE_SHA256=bbca09df11849a08e14156e690be9bb63e03416140f5e16b0030256b7c414ca2
