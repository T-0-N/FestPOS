def boot_dir() -> Path:
    b = os.environ.get("FESTPOS_BOOT")
    if b:
        return Path(b)
    return Path("/boot/firmware") if os.path.isdir("/boot/firmware") else Path("/boot")


def version_of(d: Path) -> str:
    try:
        return (d / "VERSION").read_text(encoding="utf-8").strip()
    except OSError:
        pass
    try:
        m = re.search(r'^APP_VERSION\s*=\s*"([^"]+)"', (d / "app" / "main.py").read_text(encoding="utf-8"), re.M)
        return m.group(1) if m else ""
    except OSError:
        return ""


# -- Ausgabe für die App (/run/festpos/update-status, alles 0644) -------------------------------------------------
def _status_dir() -> None:
    """Fehlende Ausgabeordner (samt Oberordnern) anlegen – 0755, unabhängig von der umask, damit die App sie lesen kann.
    Rechte ändert der Helfer nur an Ordnern, die er eben selbst angelegt hat, und nie über eine Verknüpfung; den
    Standardordner legt systemd-tmpfiles mit 0755 an (festpos-tmpfiles.conf)."""
    for p in reversed([p for p in (STATUS, *STATUS.parents) if not p.exists()]):
        try:
            p.mkdir(mode=0o755)
        except FileExistsError:
            continue                                   # inzwischen von jemand anderem angelegt: nicht anfassen
        fd = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os.fchmod(fd, 0o755)
        finally:
            os.close(fd)


def _new_file(p: Path, mode: int = 0o644) -> int:
    """Neue Datei (ohne Verknüpfungen zu folgen) mit genau diesen Rechten – die umask kürzt sie nicht (T43)."""
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    os.fchmod(fd, mode)
    return fd


def write_status(name: str, data: dict) -> None:
    _status_dir()
    tmp = STATUS / f".{name}.neu"
    tmp.unlink(missing_ok=True)
    with open(_new_file(tmp), "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, STATUS / name)


def publish_keys() -> tuple[list, list]:
    """Schlüssel der Boot-Partition für die App (die darf die Boot-Partition nicht lesen) – nur öffentliche Teile."""
    boot = boot_dir()
    keys, problems = release.load_keys(boot)
    for p in sorted(boot.glob("festpos-update*")):          # privater Schlüssel aus Versehen auf den Pi kopiert?
        if p.suffix != ".pub":
            try:
                if b"PRIVATE KEY" in release.read_regular(p, release.MAX_KEYFILE)[:200]:
                    problems.append(f"{p.name}: PRIVATER Schlüssel auf der Boot-Partition – sofort löschen!")
            except (OSError, release.ReleaseError):
                pass
    try:
        write_status("keys.json", {"at": int(time.time()), "boot": str(boot), "keys": [k.public() for k in keys],
                                   "problems": problems, "version": version_of(DEST), "backup": version_of(ALT) or None})
    except OSError as e:
        print(f"Schlüssel nicht gemeldet: {e}", file=sys.stderr)
    return keys, problems


class Protokoll:
    """Fortschritt (Ausgabe von update.sh) zeilenweise nach <id>.log – die Verwaltung zeigt die letzten Zeilen."""

    def __init__(self, rid: str | None):
        self.lines: list[str] = []
        self.f = None
        if rid:
            _status_dir()
            p = STATUS / f"{rid}.log"
            p.unlink(missing_ok=True)
            self.f = open(_new_file(p), "w", encoding="utf-8")

    def __call__(self, line: str) -> None:
        line = line.rstrip("\n")
        print(line, flush=True)                              # auch ins Journal (journalctl -u festpos-update)
        self.lines.append(line)
        if self.f:
            self.f.write(line + "\n")
            self.f.flush()

    def tail(self, n: int = 40) -> list[str]:
        return [x[:300] for x in self.lines[-n:]]

    def close(self) -> None:
        if self.f:
            self.f.close()


def run(cmd: list[str], log: Protokoll, cwd: Path | None = None) -> int:
    """Befehl ausführen, Ausgabe ins Protokoll; nach TIMEOUT abbrechen."""
    p = subprocess.Popen(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                         text=True, errors="replace", bufsize=1, start_new_session=True)

    def lesen():
        for line in p.stdout:
            log(line)
    t = threading.Thread(target=lesen, daemon=True)
    t.start()
    try:
        rc = p.wait(TIMEOUT)
    except subprocess.TimeoutExpired:
        log(f"FEHLER: nach {TIMEOUT // 60} Minuten abgebrochen")
        os.killpg(p.pid, 9)
        rc = p.wait()
    t.join(10)
    return rc


def summary(lines: list[str], ok: bool) -> str:
    """Die aussagekräftigste Zeile von update.sh (FEHLER/WARNUNG/OK) für die Anzeige."""
    for prefix in (("FEHLER", "WARNUNG") if not ok else ("WARNUNG", "OK:")):
        hits = [x for x in lines if x.startswith(prefix)]
        if hits:
            return hits[-1 if ok else 0][:300]
    return (lines[-1] if lines else "")[:300]


# -- Pakete --------------------------------------------------------------------------------------------------
def work_dir() -> Path:
    WORK.mkdir(mode=0o700, parents=True, exist_ok=True)
    st = os.lstat(WORK)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        raise RuntimeError(f"{WORK} ist kein eigener Ordner")
    os.chmod(WORK, 0o700)
    return WORK


def fresh(p: Path) -> Path:
    if p.is_dir() and not p.is_symlink():
        shutil.rmtree(p)
    else:
        p.unlink(missing_ok=True)
    return p


def take(zip_src: Path, sig_src: Path, name: str, expect_sha: str | None = None) -> dict:
    """Paket in den eigenen Ordner kopieren (die Quelle kann sich danach nicht mehr ändern)."""
    w = work_dir()
    z = fresh(w / f"{name}.zip")
    try:
        sha = release.copy_regular(zip_src, z)
        sig = release.read_regular(sig_src, release.MAX_SIG)
    except FileNotFoundError as e:
        z.unlink(missing_ok=True)
        raise release.ReleaseError("missing") from e
    except OSError as e:                                      # Verknüpfung, Pipe … (O_NOFOLLOW)
        z.unlink(missing_ok=True)
        raise release.ReleaseError("not_a_file") from e
    if expect_sha and sha != expect_sha:
        z.unlink(missing_ok=True)
        raise release.ReleaseError("sha_mismatch")
    return {"zip": z, "sig": sig, "sha": sha}


FOREIGN = ("unknown_key", "bad_signature", "sig_namespace")     # fremd signiert oder verändert


def note_foreign(p: dict, e: release.ReleaseError) -> None:
    """Fremd signiertes oder verändertes Paket: Sicherheitsereignis für Protokoll und Übersicht (T-0-N/FestPOS#11)."""
    try:
        from app import ereignisse
        ereignisse.append({"kind": "update_foreign", "code": e.code, "file": str(p.get("name") or p["zip"].name)[:80],
                           "fp": str(e.kw.get("fp") or "")[:80]})
    except Exception as x:  # noqa: BLE001 – das Update bleibt abgewiesen, auch wenn die Meldung nicht geht
        print(f"Sicherheitsereignis nicht geschrieben: {type(x).__name__}: {x}", file=sys.stderr)


def check(p: dict, keys: list) -> dict:
    """Signatur und Aufbau der Kopie prüfen -> p mit version, key."""
    try:
        key = release.verify(p["zip"], p["sig"], keys)
        info = release.inspect_zip(p["zip"])
    except release.ReleaseError as e:
        p["zip"].unlink(missing_ok=True)
        if e.code in FOREIGN:
            note_foreign(p, e)
        raise
    return {**p, "version": info["version"], "key": key, "size": p["zip"].stat().st_size}


def install(p: dict, log: Protokoll) -> dict:
    """Geprüftes Paket mit seinem update.sh einspielen -> Ergebnis."""
    before = version_of(DEST)
    if not release.newer(p["version"], before):
        p["zip"].unlink(missing_ok=True)
        raise release.ReleaseError("not_newer", version=p["version"], installed=before or "?")
    neu = fresh(work_dir() / f"neu-{os.getpid()}")               # eigener Ordner (USB und Auftrag zugleich)
    try:
        root = release.extract_zip(p["zip"], neu)
        log(f"==> Signatur gültig ({p['key'].comment or p['key'].fp}) – spiele Version {p['version']} ein")
        rc = run(["bash", str(root / "deploy" / "update.sh")], log, cwd=root)
        if rc in (0, 2) and version_of(DEST) == p["version"]:
            try:
                package_keys(root, log)                        # Schlüsselwechsel erst nach gelungenem Update
            except OSError as e:
                log(f"WARNUNG: Schlüsselwechsel aus dem Paket nicht übernommen: {type(e).__name__}: {e}")
    finally:
        shutil.rmtree(neu, ignore_errors=True)
        p["zip"].unlink(missing_ok=True)
    after = version_of(DEST)
    # 2 = läuft, wartet aber auf die Datenbank. Erfolg aber nur, wenn danach wirklich die neue Version da ist:
    # ein update.sh, das gar nicht erst läuft (z.B. Windows-Zeilenenden), endet ebenfalls mit 2.
    ok = rc in (0, 2) and after == p["version"]
    code = None if ok else "not_installed" if rc in (0, 2) else "update_failed"
    return {"ok": ok, "rc": rc, "before": before, "after": after, "code": code,
            "kw": {"installed": after or "?"} if code == "not_installed" else {}, "msg": summary(log.lines, ok)}


def _write_synced(p: Path, text: str) -> None:
    """Datei fertig schreiben und auf die Karte bringen, dann in einem Schritt an ihren Platz."""
    tmp = p.with_name(f".{p.name}.neu")
    tmp.unlink(missing_ok=True)
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644), "w", encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, p)


def package_keys(root: Path, log: Protokoll) -> None:
    """Schlüsselwechsel aus einem eben eingespielten, vertrauenswürdig signierten Paket (deploy/update-keys/):
    zurückgezogene Fingerabdrücke zur Liste auf der Boot-Partition (nie wieder entfernt), neue Schlüssel als
    festpos-update-<Fingerabdruck>.pub dazu. Dateien mit nur zurückgezogenen Schlüsseln werden umbenannt
    (*.pub.zurueckgezogen) – so bleibt sichtbar, was war."""
    src, boot = root / release.PACKAGE_KEYS, boot_dir()
    if not src.is_dir() or src.is_symlink():
        return
    revoked = release.load_revoked(boot, strict=True)        # nicht lesbar: nichts ändern (OSError -> Warnung)
    # Liste und Schlüssel des Pakets: fehlt die Liste, wird nichts zurückgezogen; ist etwas da, aber nicht lesbar oder
    # fehlerhaft, bricht der ganze Schlüsselwechsel ab (OSError -> Warnung im Protokoll), bevor etwas geändert wird
    try:
        new_revoked = release.parse_revoked_strict(release.read_regular(src / "zurueckgezogen.txt", release.MAX_KEYFILE)
                                                   .decode("utf-8", "replace")) - revoked
    except FileNotFoundError:
        new_revoked = set()
    except release.ReleaseError as e:
        raise OSError(f"zurueckgezogen.txt im Paket: {e.code}") from None
    found_all = []
    for pub in sorted(src.glob("*.pub")):
        try:
            found, bad = release.parse_keys(release.read_regular(pub, release.MAX_KEYFILE).decode("utf-8", "replace"))
        except release.ReleaseError as e:
            raise OSError(f"{pub.name} im Paket: {e.code}") from None
        if bad or not found:
            raise OSError(f"{pub.name} im Paket: kein gültiger Schlüssel")
        found_all += found
    # 1. neue Schlüssel ablegen (fertig geschrieben und auf der Karte), 2. erst dann zurückziehen: scheitert 1., gilt
    # alles wie bisher – nie ohne gültigen Schlüssel, aber mit zurückgezogenem alten
    gone = revoked | new_revoked
    have = {k.blob for k in release.load_keys(boot)[0]}
    for found in [found_all]:
        for k in found:
            if k.fp in gone or k.blob in have:
                continue
            name = "festpos-update-" + re.sub(r"[^A-Za-z0-9]", "", k.fp.removeprefix("SHA256:"))[:16] + ".pub"
            _write_synced(boot / name, f"ssh-ed25519 {base64.b64encode(k.blob).decode()} {k.comment}".rstrip() + "\n")
            have.add(k.blob)
            log(f"==> Neuer Update-Schlüssel übernommen: {k.fp} ({k.comment or name})")
    if new_revoked:
        text = "".join(f"{fp}  zurückgezogen mit Version {version_of(DEST)}\n" for fp in sorted(new_revoked))
        with open(boot / release.REVOKED_FILE, "a", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        log(f"==> Update-Schlüssel zurückgezogen: {', '.join(sorted(new_revoked))}")
        revoked |= new_revoked
    for p in sorted(boot.glob(release.KEY_GLOB)):            # Datei nur noch mit zurückgezogenen Schlüsseln
        try:
            found, _ = release.parse_keys(release.read_regular(p, release.MAX_KEYFILE).decode("utf-8", "replace"))
        except (OSError, release.ReleaseError):
            continue
        if found and all(k.fp in revoked for k in found):
            p.rename(p.with_name(p.name + ".zurueckgezogen"))
            log(f"==> {p.name}: Schlüssel zurückgezogen, Datei umbenannt")


def rollback(req: dict, log: Protokoll) -> dict:
    """Zur Sicherung /opt/festpos.alt wechseln – nur, wenn noch genau der Stand läuft, für den der Auftrag gilt."""
    before, backup = version_of(DEST), version_of(ALT)
    if not (ALT / "app").is_dir():
        raise release.ReleaseError("no_backup")
    if before != req.get("from") or (req.get("to") and backup != req.get("to")):
        raise release.ReleaseError("rollback_changed", version=before or "?", backup=backup or "?")
    src = DEST / "deploy"
    if not (src / "update.sh").is_file() or not (src / "install-lib.sh").is_file():
        raise release.ReleaseError("no_backup")
    d = fresh(work_dir() / "zurueck") / "deploy"                # Kopie: --zurueck tauscht /opt/festpos/deploy aus
    d.mkdir(parents=True)
    for f in ("update.sh", "install-lib.sh"):
        shutil.copy(src / f, d / f)
    log(f"==> Zurück von Version {before} auf {backup}")
    rc = run(["bash", str(d / "update.sh"), "--zurueck", "--ja"], log, cwd=d)
    shutil.rmtree(d.parent, ignore_errors=True)
    after = version_of(DEST)
    ok = rc == 0 and after == backup
    return {"ok": ok, "rc": rc, "before": before, "after": after, "code": None if ok else "rollback_failed",
            "msg": summary(log.lines, ok)}


