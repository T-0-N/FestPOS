# -- Ersteinrichtung über das Web (T11) ---------------------------------------------------------------------------
# Nur solange es KEINE festpos.conf gibt (dann läuft festpos-einrichtung.service statt der App). Danach ist der Modus
# endgültig aus: jeder weitere Auftrag «einrichtung» wird abgewiesen.
EINRICHTUNG_RUN = Path(os.environ.get("FESTPOS_EINRICHTUNG_RUN", "/run/festpos/einrichtung"))
EINRICHTUNG_DATA = Path(os.environ.get("FESTPOS_EINRICHTUNG_DATA", "/var/lib/festpos/einrichtung"))
CONF_EXAMPLE = DEST / "deploy" / "festpos.conf.example"
IP_RE = re.compile(r"^(25[0-5]|2[0-4]\d|1?\d?\d)(\.(25[0-5]|2[0-4]\d|1?\d?\d)){3}$")
TZ_RE = re.compile(r"^[A-Za-z0-9_/+-]{1,40}$")


def einrichtung_werte(v: dict) -> dict:
    """Werte aus dem Browser prüfen -> Einträge für festpos.conf (und Buchstabe, Netz für die Zertifikate).
    Netz mit Grösse frei wählbar (T-0-N/FestPOS#2, app/netz.py); ältere Form «prefix» = /24."""
    net = str(v.get("net") or (f"{v.get('prefix')}.0/24" if v.get("prefix") else ""))
    if not netz.parse(net):
        raise Fehler("prefix")
    ips = {k: str(v.get(k) or "") for k in ("vip", "a", "b", "c")}
    if not all(IP_RE.match(x) for x in ips.values()):
        raise Fehler("ips")
    size, node = str(v.get("cluster_size") or "1"), str(v.get("node") or "a").lower()
    if size not in ("1", "3") or node not in ("a", "b", "c") or (size == "1" and node != "a"):
        raise Fehler("node")
    d = netz.defaults(net)
    lo, hi = str(v.get("dhcp_from") or d["dhcp_from"]), str(v.get("dhcp_to") or d["dhcp_to"])
    errs = netz.plan_errors(net, ips["vip"], ips["a"], ips["b"], ips["c"], lo, hi, int(size), v.get("dhcp") is not False)
    if errs:
        raise Fehler("ips" if errs[0].startswith("ip") else "prefix")
    tz = str(v.get("tz") or "Europe/Zurich")
    if not TZ_RE.match(tz) or not Path("/usr/share/zoneinfo", tz).exists() and not TROCKEN:
        raise Fehler("tz")
    lines = netz.conf_lines(net, ips["vip"], ips["a"], ips["b"], ips["c"], lo, hi)
    gw_mode = str(v.get("gw_mode") or "auto")                # Gateway, DNS, Zeitserver (app/gateway.py)
    gw_dns = [str(x) for x in (v.get("gw_dns") or []) if str(x).strip()][:3]
    if netz.gw_errors(gw_mode, str(v.get("gw") or ""), gw_dns, str(v.get("gw_ntp") or ""), netz.parse(net),
                      avoid=list(ips.values()), pool=(lo, hi)):
        raise Fehler("gateway")
    gw = {k: x for k, x in netz.gw_conf(gw_mode, str(v.get("gw") or ""), gw_dns, str(v.get("gw_ntp") or "")).items() if x}
    return {"node": node, "net": lines["NET"], "ips": [ips["vip"], ips["a"], ips["b"], ips["c"]],
            "conf": {"CLUSTER_SIZE": size, **lines, **gw, "TZ": tz, "RTC_AKKU": "1" if v.get("rtc_akku") else "0",
                     "DHCP": "0" if v.get("dhcp") is False else "1"}}


def einrichtung_vorlage() -> str:
    try:
        return CONF_EXAMPLE.read_text(encoding="utf-8")
    except OSError:
        return "# FestPOS – erstellt von der Ersteinrichtung im Browser\nIFACE=eth0\nVRRP_ID=55\nRAFT_TLS=1\nPHONE_CERTS=1\n"


def auftrag_einrichtung(job: dict) -> dict:
    """Ersteinrichtung: festpos.conf, node.conf und festpos-tls/ auf die Boot-Partition, Uhr stellen.
    mode neu: Zertifikate hier erzeugen (ca.key geht EINMAL an die App zurück, nicht auf die Karte);
    sicherung: Schlüssel, CLUSTER_SECRET und Notfall-Passwort aus einer Sicherung (Ersatz-Pi);
    karte: Inhalt eines Ordners «karte-x» aus dem Kartenpaket (Pi B/C zu einem bestehenden Pi A)."""
    if (BOOT / "festpos.conf").exists():
        raise Fehler("configured")                     # eingerichtet: Modus endgültig aus
    if not EINRICHTUNG_RUN.exists():
        raise Fehler("not_setup")
    mode = job.get("mode")
    tls: dict[str, bytes] = {}
    out: dict = {}
    if mode == "karte":
        conf = str(job.get("conf_text") or "")
        node = str(job.get("letter") or "").lower()
        if node not in ("a", "b", "c") or not backup.conf_value(conf, "VIP") or not backup.conf_value(conf, "NODE_A_IP"):
            raise Fehler("karte")
        if (backup.conf_value(conf, "CLUSTER_SIZE") or "").strip() != "3":
            raise Fehler("karte")
        try:
            tls = {n: str(x).encode("latin-1") for n, x in (job.get("tls") or {}).items()}
        except (AttributeError, UnicodeEncodeError):
            raise Fehler("job") from None
        pruefe_tls(tls, str(netz.from_conf(conf) or ""))
    else:
        w = einrichtung_werte(job.get("values") or {})
        node, conf = w["node"], einrichtung_vorlage()
        for k, x in w["conf"].items():
            conf = backup.conf_set(conf, k, x)
        for k in ("admin_password", "cluster_secret", "admin_password_hash", "admin_password_len"):   # kein Zeilenumbruch
            if any(ord(ch) < 32 or ord(ch) == 127 for ch in str(job.get(k) or "")):
                raise Fehler("password")
        if mode == "neu":
            pw = str((job.get("values") or {}).get("admin_password") or "")
            from app import emergency
            if len(pw) < emergency.MIN_LEN or len(pw) > 128 or any(ord(ch) < 32 or ord(ch) == 127 for ch in pw):
                raise Fehler("password")
            from app import zertifikate
            try:
                made = zertifikate.make_all(w["net"], w["ips"])
            except ValueError:
                raise Fehler("ips") from None
            out["ca_key"] = made.pop("ca.key").decode()
            out["ca_crt"] = made["ca.crt"].decode()
            tls = made
            secret = secrets.token_urlsafe(32)
            from app import emergency                          # nie im Klartext auf die Karte (T-0-N/FestPOS#15)
            conf = backup.conf_set(conf, "CLUSTER_SECRET", secret)
            conf = backup.conf_admin(conf, {"admin_password_hash": emergency.make_hash(pw, secret),
                                            "admin_password_len": str(len(pw))})
        elif mode == "sicherung":
            try:
                tls = {n: str(x).encode("latin-1") for n, x in (job.get("tls") or {}).items()}
            except (AttributeError, UnicodeEncodeError):
                raise Fehler("job") from None
            pruefe_tls(tls, w["net"])                       # Sicherung aus einem anderen Netz: klare Meldung
            secret, pw = str(job.get("cluster_secret") or ""), str(job.get("admin_password") or "")
            if not backup.HASH_RE.match(str(job.get("admin_password_hash") or "")) and \
                    (not pw.strip() or pw in ("admin", "bitte-aendern")):
                raise Fehler("password")
            conf = backup.conf_admin(conf, job)
            if secret.strip() and secret.strip() not in backup.PLACEHOLDER_SECRETS:
                conf = backup.conf_set(conf, "CLUSTER_SECRET", secret)
        else:
            raise Fehler("job")
    t_ms = job.get("time_ms")
    if isinstance(t_ms, (int, float)) and t_ms > 1_700_000_000_000 and not TROCKEN:
        subprocess.run(["date", "-s", f"@{int(t_ms) // 1000}"], capture_output=True, timeout=20)
        subprocess.run(["hwclock", "-w"], capture_output=True, timeout=20)
    d = BOOT / "festpos-tls"
    d.mkdir(exist_ok=True)
    for name, data in tls.items():
        if name in backup.TLS_FILES:
            schreibe(d / name, data, 0o600 if name.endswith(".key") else 0o644)
    for name, data in (job.get("update_keys") or {}).items():
        if backup.UPDATE_KEY_RE.match(str(name)) and not (BOOT / name).exists():
            schreibe(BOOT / name, str(data).encode("latin-1", errors="replace"))
    schreibe(BOOT / "node.conf", f"NODE={node}\n".encode())
    schreibe(BOOT / "festpos.conf", conf.encode("utf-8", errors="surrogateescape"))   # zuletzt: ab jetzt eingerichtet
    EINRICHTUNG_DATA.mkdir(mode=0o750, parents=True, exist_ok=True)
    lang = str(job.get("lang") or "")
    if re.fullmatch(r"[a-z]{2}(-[a-z]+)?", lang):
        schreibe(EINRICHTUNG_DATA / "start.json", json.dumps({"lang": lang}).encode(), 0o644)
    return {**out, "node": node}


def auftrag_einrichtung_neustart(_job: dict) -> dict:
    if not (BOOT / "festpos.conf").exists() or not EINRICHTUNG_RUN.exists():
        raise Fehler("not_setup")
    return {"restart": True}


CA_DIR = "festpos-ca"
STICK_ORDNER = os.environ.get("FESTPOS_STICK_ORDNER", "")      # nur Tests: statt eines Sticks in diesen Ordner


def alter_inhalt(p: Path, n: int) -> bytes | None:
    """Inhalt einer Datei auf dem (fremden) Stick: nur eine gewöhnliche Datei, ohne Verknüpfung zu folgen und ohne auf
    eine Pipe zu warten, höchstens n+1 Bytes. None: keine gewöhnliche Datei."""
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        return os.read(fd, n + 1)
    finally:
        os.close(fd)


def ca_auf_ordner(ziel: Path, key: bytes, crt: bytes) -> str:
    """festpos-ca/ca.key und ca.crt in den Ordner; liegt dort schon ein anderer ca.key, mit Datum daneben."""
    d = ziel / CA_DIR
    if d.is_symlink() or (d.exists() and not d.is_dir()):
        raise Fehler("stick_write")
    d.mkdir(exist_ok=True)
    name = "ca.key"
    if os.path.lexists(d / name) and alter_inhalt(d / name, len(key)) != key:
        name = f"ca-{time.strftime('%Y%m%d-%H%M%S')}.key"
    for n, data in ((name, key), (name.replace(".key", ".crt"), crt)):
        tmp = d / f".{n}.neu"
        tmp.unlink(missing_ok=True)
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600), "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, d / n)
    return f"{CA_DIR}/{name}"


def auftrag_ca_key_usb(job: dict) -> dict:
    """Ersteinrichtung: verschlüsselten ca.key auf den USB-Stick. Nur während der Ersteinrichtung, nur verschlüsselt."""
    if not EINRICHTUNG_RUN.exists():
        raise Fehler("not_setup")
    key, crt = str(job.get("key") or ""), str(job.get("crt") or "")
    if not key.startswith("-----BEGIN ENCRYPTED PRIVATE KEY-----") or "-----BEGIN PRIVATE KEY" in key or \
            not crt.startswith("-----BEGIN CERTIFICATE-----") or len(key) > 8192 or len(crt) > 8192:
        raise Fehler("job")
    if STICK_ORDNER:
        return {"device": "test", "path": ca_auf_ordner(Path(STICK_ORDNER), key.encode(), crt.encode())}
    try:
        with usbstick.first_stick() as (dev, mnt):
            if not dev:
                raise Fehler("no_stick")
            try:
                path = ca_auf_ordner(mnt, key.encode(), crt.encode())
            except OSError:
                raise Fehler("stick_write") from None
    except (OSError, subprocess.SubprocessError):
        raise Fehler("stick_write") from None
    return {"device": dev, "path": path}


ARCHIV_DIR = Path(os.environ.get("FESTPOS_ARCHIV_DIR", "/var/lib/festpos/archiv"))   # schreibt die App (saison.py)
ARCHIV_STICK = "festpos-archiv"
ARCHIV_RE = re.compile(r"^festpos-saison-[0-9-]{10}_[0-9-]{10}(-[0-9]{1,3})?\.festpos$")
ARCHIV_MAX = 500 * 1024 * 1024


def archiv_auf_ordner(ziel: Path, name: str, data: bytes) -> tuple[str, str]:
    """Archiv in ziel/festpos-archiv/ schreiben (vorhandenes nie überschreiben) und zurücklesen -> (Pfad, SHA-256)."""
    d = ziel / ARCHIV_STICK
    if d.is_symlink() or (d.exists() and not d.is_dir()):   # nie über einen Verweis woandershin schreiben
        raise Fehler("stick_write")
    d.mkdir(exist_ok=True)
    out, n = d / name, 1
    while os.path.lexists(out):                                    # gleicher Name schon da: daneben, nichts überschreiben
        out = d / name.replace(".festpos", f"-{n}.festpos")
        n += 1
    schreibe(out, data)
    with open(out, "rb") as f:                               # zurücklesen: so steht es wirklich auf dem Stick
        sha = hashlib.sha256(f.read()).hexdigest()
    return f"{ARCHIV_STICK}/{out.name}", sha


def auftrag_archiv_usb(job: dict) -> dict:
    """Saison abschliessen (T-0-N/FestPOS#12): verschlüsseltes Archiv aus dem Ordner der App auf den USB-Stick."""
    name = str(job.get("name") or "")
    if not ARCHIV_RE.match(name):
        raise Fehler("job")
    try:
        fd = os.open(ARCHIV_DIR / name, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        raise Fehler("job") from None
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_size > ARCHIV_MAX:
            raise Fehler("job")
        data = f.read()
    if not data.startswith(backup.MAGIC):                      # nur verschlüsselte Dateien von FestPOS
        raise Fehler("job")
    if STICK_ORDNER:
        path, sha = archiv_auf_ordner(Path(STICK_ORDNER), name, data)
        return {"device": "test", "path": path, "sha": sha}
    try:
        with usbstick.first_stick() as (dev, mnt):
            if not dev:
                raise Fehler("no_stick")
            try:
                path, sha = archiv_auf_ordner(mnt, name, data)
            except OSError:
                raise Fehler("stick_write") from None
    except (OSError, subprocess.SubprocessError):
        raise Fehler("stick_write") from None
    return {"device": dev, "path": path, "sha": sha}


OS_UPDATE_BIN = os.environ.get("FESTPOS_OS_UPDATE_BIN", "/usr/local/sbin/festpos-os-update")


def auftrag_os_online(_job: dict) -> dict:
    """Sicherheitsupdates des Betriebssystems mit Internet (T-0-N/FestPOS#5): festpos-os-update --online."""
    try:
        r = subprocess.run([OS_UPDATE_BIN, "--online"], capture_output=True, text=True, timeout=3600)
    except (OSError, subprocess.TimeoutExpired):
        raise Fehler("os_update") from None
    if r.returncode:
        raise Fehler("os_update")
    return {}


def krypt(arg: str, job: dict | None = None, timeout: float = 600, binary: str = "") -> dict:
    """festpos-krypt (Daten verschlüsselt, T-0-N/FestPOS#3) oder festpos-netz (Netz umziehen, #2) aufrufen -> seine
    Antwort (JSON, letzte Zeile)."""
    try:
        r = subprocess.run([binary or KRYPT_BIN, arg], input=json.dumps(job or {}), capture_output=True, text=True,
                           timeout=timeout)
        res = json.loads((r.stdout.strip().splitlines() or ["null"])[-1])
    except (OSError, ValueError, subprocess.TimeoutExpired):
        raise Fehler("krypt") from None
    if not isinstance(res, dict) or not res.get("ok"):
        raise Fehler(str((res or {}).get("code") or "krypt") if isinstance(res, dict) else "krypt")
    return res


def auftrag_krypt_umstellen(job: dict) -> dict:
    """Daten verschlüsseln: beim nächsten Start (bevor FestPOS läuft), darum gleich neu starten."""
    krypt("--umstellen", {"recovery": str(job.get("recovery") or "")})
    return {"restart": True}


def auftrag_krypt_bestaetigen(_job: dict) -> dict:
    krypt("--bestaetigen")
    return {}


