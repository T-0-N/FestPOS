def melde(job_id: str, res: dict) -> None:
    ERGEBNISSE.mkdir(mode=0o755, parents=True, exist_ok=True)
    data = res.pop("zip", None)
    if data is not None:
        schreibe(ERGEBNISSE / f"{job_id}.zip", data, 0o640)
        if not TROCKEN:
            try:
                shutil.chown(ERGEBNISSE / f"{job_id}.zip", "root", "festpos")
            except (LookupError, OSError):
                pass
    schreibe(ERGEBNISSE / f"{job_id}.json", json.dumps(res).encode(), 0o644)


def aufraeumen() -> None:
    """Alte Antworten (älter als 5 Minuten) löschen – /run ist im Arbeitsspeicher, ein Kartenpaket enthält Schlüssel."""
    grenze = time.time() - 300
    try:
        for e in os.scandir(ERGEBNISSE):
            if e.is_file(follow_symlinks=False) and e.stat(follow_symlinks=False).st_mtime < grenze:
                os.unlink(e.path)
    except OSError:
        pass


def anfragen() -> int:
    jobs = []
    try:
        eintraege = list(os.scandir(ANFRAGEN))
    except OSError:
        return 0
    for e in eintraege:
        m = NAME_RE.fullmatch(e.name)
        if m:
            jobs.append((e.stat(follow_symlinks=False).st_mtime, m.group(1), lies(e.path)))
        # ALLES entfernen (auch Fremdes), sonst startet systemd den Dienst immer wieder (DirectoryNotEmpty)
        try:
            if e.is_dir(follow_symlinks=False):
                shutil.rmtree(e.path)
            else:
                os.unlink(e.path)
        except OSError:
            pass
    rc, restart = 0, False
    for _, job_id, job in sorted(jobs, key=lambda j: j[0]):
        fn = AUFTRAEGE.get((job or {}).get("kind"))
        try:
            if not fn:
                raise Fehler("job")
            res = fn(job)
            restart = restart or bool(res.get("restart"))
            print(f"Auftrag {job['kind']} ausgeführt")
            melde(job_id, {"ok": True, **res})
        except Fehler as e:
            print(f"Auftrag {(job or {}).get('kind')} abgelehnt: {e.code}", file=sys.stderr)
            melde(job_id, {"ok": False, "code": e.code})
            rc = 2
        except ValueError as e:                              # z.B. Steuerzeichen in einem Wert für festpos.conf
            print(f"Auftrag {(job or {}).get('kind')} abgelehnt: {e}", file=sys.stderr)
            melde(job_id, {"ok": False, "code": "job"})
            rc = 2
        except OSError as e:
            print(f"Auftrag {(job or {}).get('kind')} gescheitert: {type(e).__name__}", file=sys.stderr)
            melde(job_id, {"ok": False, "code": "io"})
            rc = 2
    aufraeumen()
    if restart:
        print("Pi startet neu")
        neu_starten()
    return rc


def main(argv: list[str]) -> int:
    if argv[1:2] == ["--anfrage"]:
        return anfragen()
    print("Aufruf: festpos-wiederherstellen --anfrage", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
