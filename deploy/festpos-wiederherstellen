class Fehler(Exception):
    def __init__(self, code: str):
        super().__init__(code)
        self.code = code


# -- Dateien ------------------------------------------------------------------------------------------------------
def lies(path: str) -> dict | None:
    """Kleine, normale Datei (kein Symlink) mit einem JSON-Objekt."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > MAX_JOB:
            return None
        data = b""
        while chunk := os.read(fd, 65536):
            data += chunk
    finally:
        os.close(fd)
    try:
        job = json.loads(data)
    except ValueError:
        return None
    return job if isinstance(job, dict) else None


def schreibe(path: Path, data: bytes, mode: int = 0o644) -> None:
    """Erst fertig schreiben, dann in einem Schritt ersetzen (auch auf FAT der Boot-Partition)."""
    tmp = path.with_name(f".{path.name}.neu")
    tmp.unlink(missing_ok=True)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        os.write(fd, data)
        os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(tmp, path)


def conf_text() -> str:
    """festpos.conf, wie sie gilt – bei verschlüsselten Daten mit den Werten aus dem Container (T-0-N/FestPOS#3)."""
    try:
        return geheim.merged((BOOT / "festpos.conf").read_text(encoding="utf-8", errors="surrogateescape"))
    except OSError:
        raise Fehler("conf") from None


def conf_schreiben(text: str) -> None:
    """festpos.conf schreiben, dann (verschlüsselt) die Geheimnisse in den Container. Alle Aufrufer starten danach neu;
    scheitert das Verschieben, erledigt es festpos-krypt beim Start – der Auftrag gilt trotzdem (nie halb: neue
    festpos.conf ohne Neustart)."""
    schreibe(BOOT / "festpos.conf", text.encode("utf-8", errors="surrogateescape"))
    try:
        einziehen()
    except Fehler:
        print("festpos-wiederherstellen: Geheimnisse nicht verschoben – beim Neustart", file=sys.stderr)


def einziehen() -> None:
    """Daten verschlüsselt: geheime Werte und Schlüssel gleich wieder von der Boot-Partition in den Container."""
    if not os.path.exists(KRYPT_BIN):
        return
    try:
        r = subprocess.run([KRYPT_BIN, "--einziehen"], capture_output=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        raise Fehler("krypt") from None                    # festpos.conf ist geschrieben; verschoben wird beim Start
    if r.returncode:
        raise Fehler("krypt")


def wirksames_geheimnis(text: str) -> str:
    try:
        return kartenboot.effective_secret(text, BOOT, ETC)
    except kartenboot.KartenFehler as e:
        raise Fehler(e.code) from None


def alt_behalten(stamp: str) -> None:
    """Bisherige festpos-tls/ und festpos.conf daneben legen (festpos-tls.alt-DATUM)."""
    tls = BOOT / "festpos-tls"
    if tls.is_dir():
        shutil.copytree(tls, BOOT / f"festpos-tls.alt-{stamp}", dirs_exist_ok=True)
    conf = BOOT / "festpos.conf"
    if conf.is_file():
        shutil.copy2(conf, BOOT / f"festpos.conf.alt-{stamp}")


def neu_starten() -> None:
    if TROCKEN:
        return
    r = subprocess.run(["systemd-run", "--on-active=5", "--unit=festpos-wiederherstellen-neustart",
                        "systemctl", "reboot"], capture_output=True, timeout=20)
    if r.returncode != 0:
        subprocess.run(["shutdown", "-r", "+0"], capture_output=True, timeout=20)


def einzelbetrieb(text: str) -> bool:
    return (backup.conf_value(text, "CLUSTER_SIZE") or "1").strip() == "1"


# -- Prüfen ---------------------------------------------------------------------------------------------------------
def pruefe_tls(files: dict[str, bytes], net: str | None = None) -> None:
    """Nur bekannte Namen, gültiges PEM, Schlüssel passt zum Zertifikat, Server-Zertifikat von der Server-CA – und
    (net) die Server-CA gilt für dieses Netz (sonst: Sicherung/Karte aus einem anderen Netz, T-0-N/FestPOS#2)."""
    from cryptography import x509
    from cryptography.hazmat.primitives import serialization
    if not set(files) <= set(backup.TLS_FILES) or not {"ca.crt", "server.crt", "server.key"} <= set(files):
        raise Fehler("tls_files")
    certs, keys = {}, {}
    try:
        for name, data in files.items():
            if name.endswith(".crt"):
                certs[name] = x509.load_pem_x509_certificate(data)
            else:
                keys[name] = serialization.load_pem_private_key(data, password=None)
    except (ValueError, TypeError):
        raise Fehler("tls_pem") from None

    def pub(o):
        return o.public_key().public_bytes(serialization.Encoding.DER, serialization.PublicFormat.SubjectPublicKeyInfo)
    if pub(certs["server.crt"]) != pub(keys["server.key"]):
        raise Fehler("tls_pair")
    if certs["server.crt"].issuer != certs["ca.crt"].subject:
        raise Fehler("tls_issuer")
    if "device-ca.key" in keys and ("device-ca.crt" not in certs or pub(certs["device-ca.crt"]) != pub(keys["device-ca.key"])):
        raise Fehler("tls_pair")
    from app import zertifikate
    if zertifikate.other_net(files["ca.crt"], net):
        raise Fehler("tls_net")


# -- Aufträge -------------------------------------------------------------------------------------------------------
def auftrag_keys(job: dict) -> dict:
    text = conf_text()
    if not einzelbetrieb(text):
        raise Fehler("cluster")                       # im Cluster müssten alle Karten gleich ersetzt werden
    try:
        files = {n: str(v).encode("latin-1") for n, v in (job.get("tls") or {}).items()}
        update_keys = sorted(str(n) for n in (job.get("update_keys") or {}))
    except (AttributeError, UnicodeEncodeError):
        raise Fehler("job") from None
    pruefe_tls(files, str(netz.from_conf(text) or ""))
    conf = job.get("conf") or {}
    if not isinstance(conf, dict):
        raise Fehler("job")
    # festpos.conf fertig rechnen, BEVOR etwas ersetzt wird (ein Wert mit Zeilenumbruch wird abgewiesen)
    secret = str(conf.get("cluster_secret") or "")
    try:
        if secret.strip() not in backup.PLACEHOLDER_SECRETS:
            text = backup.conf_set(text, "CLUSTER_SECRET", secret)
        text = backup.conf_admin(text, conf)                   # Prüfwert (oder älterer Klartext)
    except ValueError:
        raise Fehler("conf_value") from None
    alt_behalten(time.strftime("%Y%m%d-%H%M%S"))
    tls = BOOT / "festpos-tls"
    tls.mkdir(exist_ok=True)
    for name, data in files.items():
        schreibe(tls / name, data, 0o600 if name.endswith(".key") else 0o644)
    conf_schreiben(text)
    # Update-Schlüssel der Sicherung, die hier fehlen: nur melden (Prüfliste), nie schreiben
    skipped = [n for n in update_keys if backup.UPDATE_KEY_RE.match(n) and not (BOOT / n).exists()]
    return {"restart": True, "files": sorted(files), "update_keys_skipped": skipped}


def auftrag_kartenpaket(job: dict) -> dict:
    letters = job.get("letters") or []
    if not letters or not all(x in ("a", "b", "c") for x in letters):
        raise Fehler("letters")
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("LIESMICH.txt", str(job.get("readme") or ""))
        for x in letters:
            try:
                files = kartenboot.boot_files(BOOT, ETC, x)          # gleich wie «SD-Karte schreiben» (T10)
            except kartenboot.KartenFehler as e:
                raise Fehler(e.code) from None
            for name, data in files.items():
                z.writestr(f"karte-{x}/{name}", data)
    return {"zip": buf.getvalue(), "letters": letters}


def auftrag_cluster3(_job: dict) -> dict:
    text = conf_text()
    if not einzelbetrieb(text):
        raise Fehler("not_single")
    secret = wirksames_geheimnis(text)                 # festschreiben: B und C bekommen dasselbe (Kartenpaket)
    alt_behalten(time.strftime("%Y%m%d-%H%M%S"))
    conf_schreiben(backup.conf_set(backup.conf_set(text, "CLUSTER_SIZE", "3"), "CLUSTER_SECRET", secret))
    return {"restart": True}


def auftrag_apk(_job: dict) -> dict:
