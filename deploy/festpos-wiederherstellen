def auftrag_netz_gateway(job: dict) -> dict:
    """Gateway, DNS und Zeitserver (Verwaltung › Netz & Internet): in festpos.conf und gleich übernehmen."""
    res = krypt("--gateway", {k: job.get(k) for k in ("mode", "gateway", "dns", "ntp", "rev")}, 180, NETZ_BIN)
    return {"applied": res.get("applied"), "rev": res.get("rev")}


def karte(arg: str, job: dict | None = None, timeout: float = 60) -> dict:
    """festpos-karte aufrufen (T10: SD-Karte im USB-Kartenleser schreiben) -> seine Antwort (JSON)."""
    try:
        r = subprocess.run(([sys.executable, "-I"] if os.environ.get("FESTPOS_KARTE_PYTHON") else []) + [KARTE_BIN, arg],
                           input=json.dumps(job or {}), capture_output=True, text=True, timeout=timeout)
        res = json.loads(r.stdout or "null")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        raise Fehler("karte") from None
    if isinstance(res, dict) and res.get("ok") is False:
        raise Fehler(str(res.get("code") or "karte"))
    return res if isinstance(res, dict) else {}


def auftrag_karten(_job: dict) -> dict:
    return {"liste": karte("--liste"), "status": karte("--status") or None}


def auftrag_karte_schreiben(job: dict) -> dict:
    return karte("--auftrag", {k: job.get(k) for k in ("device", "serial", "size", "letter", "confirm")})


def auftrag_karte_abbrechen(_job: dict) -> dict:
