[Unit]
Description=FestPOS: Rolle aus node.conf anwenden (IP, Hostname, Konfiguration)
After=local-fs.target NetworkManager.service
Wants=NetworkManager.service
# NICHT Before=nftables.service: nftables läuft vor network-pre.target, NetworkManager danach ->
# Abhängigkeitskreis, systemd wirft dann NetworkManager raus (Pi ohne Netz). Firewall lädt das Skript selbst.
Before=network-online.target rqlited.service keepalived.service chrony.service festpos.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/festpos-node

[Install]
WantedBy=multi-user.target
