[Unit]
Description=FestPOS: Ersteinrichtung im Browser (nur ohne festpos.conf, T11)
After=festpos-node.service network-online.target
Requires=festpos-node.service
# festpos-node legt die Datei an, wenn es keine festpos.conf gibt; sonst bleibt der Dienst aus
ConditionPathExists=/run/festpos/einrichtung

[Service]
User=festpos
Group=festpos
WorkingDirectory=/opt/festpos
Environment=FESTPOS_STATIC=/opt/festpos/static
# https 443 mit vorläufigem Zertifikat (festpos-node), Port 80 leitet um (app/setup_serve.py)
ExecStart=/opt/festpos/venv/bin/python -m app.setup_serve
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
