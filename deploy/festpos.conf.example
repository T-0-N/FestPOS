# FestPOS – Cluster-Konfiguration
# Liegt auf der BOOT-Partition (/boot/firmware/festpos.conf) und ist auf ALLEN Karten identisch.
# Die Boot-Partition ist FAT32 -> am Windows/Mac-PC direkt editierbar.

# 1 = ein einzelner Pi (Start), 3 = Cluster aus drei Pis.
# Wechsel 1 -> 3: hier auf 3 setzen, Pi A neu starten, Karten B und C einstecken. Daten bleiben.
CLUSTER_SIZE=1

NET_PREFIX=192.168.55
NET_CIDR=24
IFACE=eth0

VIP=192.168.55.10            # Adresse für die Handys: https://192.168.55.10
NODE_A_IP=192.168.55.11
NODE_B_IP=192.168.55.12
NODE_C_IP=192.168.55.13

VRRP_ID=55                   # 1..255, eindeutig im Netz
# 1 = Datenbank-Verkehr zwischen den Pi verschlüsselt und gegenseitig geprüft (empfohlen, wirkt erst bei 3 Pi).
# Ändern nur, wenn danach ALLE Pi zusammen neu gestartet werden.
RAFT_TLS=1
TZ=Europe/Zurich
# RTC-Batterie: 1 = die Pi haben die offizielle, aufladbare Batterie (SC1163) – dann lädt der Pi sie, solange er Strom
# hat (trägt dtparam=rtc_bbat_vchg=3000000 in config.txt ein, wirkt nach dem nächsten Neustart). Bei einer normalen
# CR2032 oder ohne Batterie 0 lassen: eine CR2032 darf nicht geladen werden. Ein Pi mit anderer Batterie: RTC_AKKU in
# seiner node.conf.
RTC_AKKU=0

# 1 = Bestellen nur mit Gerätezertifikat auf dem Handy (empfohlen), 0 = jedes Gerät im WLAN
PHONE_CERTS=1

# DHCP für die Handys: 1 = die Pi vergeben Adressen – feste pro Handy (trägt «Neues Handy ausrollen» in der
# Verwaltung ein) und für neue Geräte aus DHCP_POOL (letzte Stelle «von-bis», bei 3 Pi auf die Pi aufgeteilt).
# 0 = aus (alle Geräte mit fester IP). Kein zweiter DHCP-Server im Netz (Mobilfunk-Router: DHCP aus).
DHCP=1
DHCP_POOL=150-189
# Gateway und DNS für die Handhelds: Gateway leer (empfohlen) = automatisch nach Verwaltung › Internet – dauerhaft
# über einen Router im FestPOS-Netz verbunden: der Router, sonst die Pi (VIP), die das Internet weitergeben. Eine feste
# Adresse (z.B. 192.168.55.1) gilt immer. DNS leer = 1.1.1.1.
DHCP_GATEWAY=
DHCP_DNS=

# Verwaltung: https://192.168.55.10:8443/admin.html  (Benutzer: admin). Passwort UNBEDINGT ändern.
ADMIN_PASSWORD=bitte-aendern
# Geheimnis für die Pi untereinander (Uhrzeit stellen). Optional: bleibt der Platzhalter stehen, wird es
# automatisch aus dem Server-Schlüssel abgeleitet. Wenn gesetzt: lange Zufallszeichenkette, auf allen Karten gleich.
CLUSTER_SECRET=bitte-aendern-lang-und-zufaellig

# SSH (Fernzugang zum Pi) nur von diesen Adressen – nicht von Handys und Gästen im WLAN.
# IP, IP-IP (Bereich) oder IP/24, mit Komma getrennt (ohne Überschneidungen). Leer = ganzes Netz.
# Ausgesperrt? Die Karte am PC einstecken und hier ändern.
SSH_FROM=192.168.55.200-192.168.55.254
# Verwaltung (Port 8443) nur von diesen Adressen, gleiche Schreibweise wie SSH_FROM. Leer = ganzes Netz.
# Offen bleiben der Zertifikat-Download für neue Handys (QR-Link) und die Pi untereinander; Handys mit
# Gerätezertifikat kommen über https://192.168.55.10 weiter in die Verwaltung. Wirkt nur mit PHONE_CERTS=1.
ADMIN_FROM=
# QR-Bestellung am Tisch (T22): Internet für den Pi über den Mobilfunk-Router (Payrexx, Cloudflare Tunnel).
# Leer = kein Internet (wie bisher). Gilt für jeden Pi.
INTERNET_GATEWAY=
INTERNET_DNS=
# Token des Cloudflare Tunnels (Cloudflare › Zero Trust › Networks › Tunnels › Token) – geheim halten.
# Leer = keine QR-Bestellung (Gästedienst und Tunnel aus).
TUNNEL_TOKEN=
