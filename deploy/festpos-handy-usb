#!/usr/bin/python3
"""FestPOS – Handy per USB am Pi: den Pi als Zeitserver des Handys eintragen (T2, läuft als root).

  festpos-handy-usb USB-SCHNITTSTELLE     von festpos-handy-usb@.service (udev hat eine ADB-Schnittstelle gesehen)

Ablauf: warten, bis das Handy USB-Debugging für diesen Pi zulässt (auf dem Handy «Zulassen», höchstens 2 Minuten),
dann per adb
  settings put global ntp_server <VIP>    Android fragt für «Automatische Uhrzeit» den Pi statt time.android.com
  settings put global auto_time 1         automatische Uhrzeit ein
nachprüfen und zum Schluss USB-Debugging wieder ausschalten (settings put global adb_enabled 0).
Das Ergebnis steht in /run/festpos/handy-usb/<Seriennummer>.json (Seriennummer, Modell, Android, WLAN-Adresse,
gesetzt ja/nein, Fehler); die App zeigt es unter Geräte und beim Einrichten eines Handys.

Der ADB-Schlüssel dieses Pi liegt in /var/lib/festpos/adb (HOME des Dienstes, nur root). Mehrere Handys nacheinander:
ein Lauf nach dem anderen (Sperre), damit sich die Läufe den adb-Server nicht gegenseitig beenden.
"""
import fcntl
import json
import os
import re
import subprocess
import sys
import time

ADB = os.environ.get("FESTPOS_ADB", "adb")
OUT = os.environ.get("FESTPOS_HANDY_USB_DIR", "/run/festpos/handy-usb")
VIP = os.environ.get("FESTPOS_VIP", "")
WAIT_S = float(os.environ.get("FESTPOS_HANDY_USB_WAIT", "120"))
LOCK = os.path.join(OUT, ".sperre")
IP_RE = re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}$")
SAFE = re.compile(r"[^A-Za-z0-9 ._:+()/-]")


def adb(*args: str, serial: str = "", timeout: float = 15) -> tuple[int, str]:
    cmd = [ADB] + (["-s", serial] if serial else []) + list(args)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout or "").strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def clean(v: str, n: int = 60) -> str:
    return SAFE.sub("", v or "")[:n]


def find_device(usb_path: str) -> tuple[str, str] | None:
    """(Seriennummer, Zustand) des Handys an dieser USB-Buchse – «device», «unauthorized» … Sonst das einzige."""
    code, out = adb("devices", "-l")
    rows = []
    for line in out.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2:
            rows.append((parts[0], parts[1], " ".join(parts[2:])))
    for serial, state, rest in rows:
        if usb_path and f"usb:{usb_path}" in rest.split():
            return serial, state
    return (rows[0][0], rows[0][1]) if len(rows) == 1 else None


def write(serial: str, data: dict) -> None:
    os.makedirs(OUT, mode=0o755, exist_ok=True)
    name = re.sub(r"[^A-Za-z0-9_-]", "_", serial)[:40] or "unbekannt"
    tmp = os.path.join(OUT, f".{name}.neu")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(json.dumps({"serial": serial, **data}, ensure_ascii=False) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(OUT, f"{name}.json"))


def run(usb_if: str) -> int:
    usb_path = usb_if.split(":", 1)[0]                     # «1-1:1.1» -> «1-1» (so nennt adb die Buchse)
    if not IP_RE.match(VIP):
        print("FESTPOS_VIP fehlt (/etc/festpos/env) – nichts gesetzt", file=sys.stderr)
        return 2
    started = time.time()
    end = time.monotonic() + WAIT_S
    found, told = None, False
    while time.monotonic() < end:
        found = find_device(usb_path)
        if found and found[1] == "device":
            break
        if found and found[1] == "unauthorized" and not told:   # Frage auf dem Handy: «Zulassen» tippen
            write(found[0], {"at": round(started), "ok": None, "state": "unauthorized"})
            told = True
        time.sleep(1)
    if not found or found[1] != "device":
        if found:
            write(found[0], {"at": round(started), "ok": False, "error": "not_allowed"})
        return 3
    serial = found[0]
    info = {"model": clean(adb("shell", "getprop", "ro.product.model", serial=serial)[1]),
            "android": clean(adb("shell", "getprop", "ro.build.version.release", serial=serial)[1], 10)}
    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", adb("shell", "ip", "-4", "-o", "addr", "show", "wlan0", serial=serial)[1])
    info["ip"] = m.group(1) if m else None
    steps = {}
    for key, value in (("ntp_server", VIP), ("auto_time", "1")):
        code, _ = adb("shell", "settings", "put", "global", key, value, serial=serial)
        steps[key] = code == 0 and adb("shell", "settings", "get", "global", key, serial=serial)[1] == value
    ok = all(steps.values())
    # zum Schluss USB-Debugging aus (die Verbindung bricht dabei ab – das ist so gewollt)
    code, _ = adb("shell", "settings", "put", "global", "adb_enabled", "0", serial=serial, timeout=8)
    steps["adb_off"] = code == 0
    write(serial, {"at": round(started), "ok": ok, "steps": steps, **info,
                   "error": None if ok else "settings"})
    print(f"Handy {serial} ({info['model']}): Zeitserver {VIP} {'gesetzt' if ok else 'NICHT gesetzt'} {steps}")
    return 0 if ok else 4


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("Aufruf: festpos-handy-usb USB-SCHNITTSTELLE (z.B. 1-1:1.1)", file=sys.stderr)
        return 2
    os.makedirs(OUT, mode=0o755, exist_ok=True)
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)                     # ein Handy nach dem anderen
        try:
            return run(argv[1])
        finally:
            adb("kill-server", timeout=5)                   # keinen adb-Server als root liegen lassen


if __name__ == "__main__":
    sys.exit(main(sys.argv))
