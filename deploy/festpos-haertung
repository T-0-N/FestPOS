#!/bin/bash
# FestPOS – Härtung von SSH und sudo (T23, Entscheid: SSH nur mit Schlüssel).
#
# Läuft als root bei jedem Start (festpos-node) und beim Installieren/Update (install-lib.sh):
#   1. SSH-Schlüssel übernehmen: liegt auf der Boot-Partition «festpos-ssh.pub» (am PC auf die SD-Karte kopiert),
#      kommen die Schlüssel daraus zum ersten Benutzer (UID 1000) – so sperrt sich niemand aus.
#   2. sshd: nur Schlüssel, kein root, wenige Versuche, keine Weiterleitungen (/etc/ssh/sshd_config.d/10-festpos.conf;
#      Dateien in sshd_config.d gelten vor sshd_config, die erste Angabe zählt – auch vor den Einstellungen des Imagers).
#   3. sudo: nur mit Passwort. «NOPASSWD» des ersten Benutzers (Raspberry Pi OS: /etc/sudoers.d/010_pi-nopasswd) fällt
#      weg, sobald dieser Benutzer ein Passwort hat; ohne Passwort bleibt es (sonst gäbe es gar kein sudo mehr) und die
#      Warnung steht im Journal.
#
#   4. Start nur von der SD-Karte: Bootloader (EEPROM) BOOT_ORDER=0xf1 und keine Netzwerk-Installation – sonst startet
#      jemand mit kurzem Zugang ein fremdes System von USB oder über das Netz und liest die SD-Karte. Geschrieben wird
#      mit rpi-eeprom-config --apply; wirksam nach dem nächsten Neustart. Rückgängig: Wiederherstellungs-Karte
#      (Raspberry Pi Imager › Misc utility images › Bootloader), siehe ANLEITUNG.
#   5. Bluetooth aus (dtoverlay=disable-bt in config.txt, Dienste aus).
#   6. Keine Anmeldung an der Konsole: am Bildschirm zeigt tty1 weiter den Hinweistext (z.B. den Einrichtungscode),
#      nimmt aber keinen Benutzer an; keine weiteren Konsolen (logind), keine serielle Konsole.
#   Ergebnis für die App (Verwaltung › Pi): /run/festpos-haertung.json.
#
#   festpos-haertung              alles anwenden (still, Meldungen ins Journal)
#   festpos-haertung --stand      nur zeigen, wie es steht (JSON)
#   festpos-haertung --kein-login an der Konsole statt der Anmeldung (getty@tty1): Hinweis zeigen und warten
#
# Tests: FESTPOS_TEST_ROOT (alle Systempfade darunter), FESTPOS_BOOT (Boot-Partition).
set -uo pipefail
R=${FESTPOS_TEST_ROOT:-}
BOOT=${FESTPOS_BOOT:-$R/boot/firmware}
[ -d "$BOOT" ] || BOOT=$R/boot
SSHD_DROP=$R/etc/ssh/sshd_config.d/10-festpos.conf
SUDO_DROP=$R/etc/sudoers.d/festpos-haertung
KEYFILE=festpos-ssh.pub
STATE=${FESTPOS_HAERTUNG_STATE:-$R/run/festpos-haertung.json}
UNITS=$R/etc/systemd/system
GETTY_DROP=$UNITS/getty@tty1.service.d/zz-festpos-kein-login.conf
LOGIND_DROP=$R/etc/systemd/logind.conf.d/festpos-konsole.conf
SERIAL_GETTYS="serial-getty@ttyAMA10.service serial-getty@ttyAMA0.service serial-getty@ttyS0.service"
BOOT_ORDER_WANT=0xf1               # 1 = SD-Karte, f = von vorne (nie USB, NVMe oder Netz)
SELF=/usr/local/sbin/festpos-haertung

log() { if [ -n "$R" ]; then echo "festpos-haertung: $*" >&2; else logger -t festpos-haertung -- "$*" 2>/dev/null || echo "$*" >&2; fi; }

first_user() {                     # Name, Home des ersten Benutzers (UID 1000)
  awk -F: '$3 == 1000 { print $1 ":" $6; exit }' "$R/etc/passwd" 2>/dev/null
}

has_password() {                   # has_password NAME -> 0, wenn ein gültiges Passwort gesetzt ist
  local h
  h=$(awk -F: -v u="$1" '$1 == u { print $2; exit }' "$R/etc/shadow" 2>/dev/null)
  [ -n "$h" ] && [ "${h:0:1}" != "!" ] && [ "${h:0:1}" != "*" ]
}

key_count() {                      # key_count DATEI -> Anzahl gültiger öffentlicher Schlüssel
  local n=0 line
  [ -f "$1" ] || { echo 0; return; }
  while IFS= read -r line; do
    case "$line" in ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-*\ *|sk-ssh-ed25519@openssh.com\ *|sk-ecdsa-sha2-*\ *) n=$((n + 1)) ;; esac
  done < "$1"
  echo "$n"
}

take_keys() {                      # Schlüssel von der Boot-Partition zum ersten Benutzer
  local src=$BOOT/$KEYFILE user home ak line added=0 tmp
  [ -f "$src" ] || return 0
  IFS=: read -r user home <<< "$(first_user)"
  if [ -z "$user" ]; then log "$KEYFILE gefunden, aber kein Benutzer mit UID 1000"; return 0; fi
  home=$R$home
  ak=$home/.ssh/authorized_keys
  install -d -m 0700 "$home/.ssh"
  touch "$ak"; chmod 0600 "$ak"
  tmp=$(mktemp)
  tr -d '\r' < "$src" > "$tmp"                  # vom Windows-PC: CRLF
  while IFS= read -r line; do
    line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$line" in
      ssh-ed25519\ *|ssh-rsa\ *|ecdsa-sha2-*\ *|sk-ssh-ed25519@openssh.com\ *|sk-ecdsa-sha2-*\ *) ;;
      ''|'#'*) continue ;;
      *) log "Zeile in $KEYFILE ist kein öffentlicher SSH-Schlüssel – übersprungen"; continue ;;
    esac
    if command -v ssh-keygen >/dev/null && ! echo "$line" | ssh-keygen -l -f - >/dev/null 2>&1; then
      log "Schlüssel in $KEYFILE ist ungültig – übersprungen"; continue
    fi
    # schon vorhanden (gleicher Typ und Schlüssel, Kommentar egal)?
    if awk -v k="$(echo "$line" | awk '{print $1" "$2}')" '($1" "$2) == k { f=1 } END { exit !f }' "$ak"; then continue; fi
    echo "$line" >> "$ak"; added=$((added + 1))
  done < "$tmp"
  rm -f "$tmp"
  chown -R "$user:$user" "$home/.ssh" 2>/dev/null || [ -n "$R" ]
  mv -f "$src" "$src.uebernommen" 2>/dev/null || true   # nicht bei jedem Start nochmals; sichtbar am PC
  log "$added SSH-Schlüssel für $user übernommen"
}

write_sshd() {
  install -d "${SSHD_DROP%/*}"
  local new
  new=$(mktemp)
  cat > "$new" << 'EOF'
# FestPOS (T23): SSH nur mit Schlüssel. Wird von festpos-haertung bei jedem Start geschrieben – nicht von Hand ändern.
# Schlüssel hinzufügen: am PC die Datei festpos-ssh.pub (öffentlicher Schlüssel) auf die Boot-Partition der SD-Karte.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PubkeyAuthentication yes
AuthenticationMethods publickey
MaxAuthTries 3
LoginGraceTime 30
MaxStartups 4:50:10
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding no
PermitTunnel no
ClientAliveInterval 300
ClientAliveCountMax 2
EOF
  if ! cmp -s "$new" "$SSHD_DROP"; then
    [ -f "$SSHD_DROP" ] && cp -p "$SSHD_DROP" "$SSHD_DROP.alt"
    install -m 0644 "$new" "$SSHD_DROP"
    if [ -z "$R" ] && command -v sshd >/dev/null && compgen -G "/etc/ssh/ssh_host_*_key" >/dev/null && ! sshd -t >/dev/null 2>&1; then
      if [ -f "$SSHD_DROP.alt" ]; then mv -f "$SSHD_DROP.alt" "$SSHD_DROP"; else rm -f "$SSHD_DROP"; fi
      rm -f "$new"; log "FEHLER: sshd-Prüfung scheitert mit den neuen Einstellungen – nicht geändert"; return 1
    fi
    rm -f "$SSHD_DROP.alt"
    log "sshd: nur noch Schlüssel"
    [ -n "$R" ] || systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true   # Sitzungen bleiben
  fi
  rm -f "$new"
}

write_sudo() {
  local user home f new
  IFS=: read -r user home <<< "$(first_user)"
  install -d -m 0750 "$R/etc/sudoers.d"
  new=$(mktemp)
  cat > "$new" << 'EOF'
# FestPOS (T23): sudo nur mit Passwort, kurz gültig, protokolliert. Von festpos-haertung geschrieben.
Defaults use_pty
Defaults passwd_tries=3
Defaults timestamp_timeout=5
Defaults logfile=/var/log/sudo.log
EOF
  if [ -z "$R" ] && command -v visudo >/dev/null && ! visudo -cqf "$new" >/dev/null 2>&1; then
    rm -f "$new"; log "FEHLER: sudo-Einstellungen ungültig – nicht geändert"; return 1
  fi
  cmp -s "$new" "$SUDO_DROP" || install -m 0440 "$new" "$SUDO_DROP"
  rm -f "$new"
  [ -n "$user" ] || return 0
  for f in "$R"/etc/sudoers.d/*; do
    if [ ! -f "$f" ] || [ "$f" = "$SUDO_DROP" ]; then continue; fi
    grep -qE "^[[:space:]]*${user}[[:space:]].*NOPASSWD" "$f" || continue
    if has_password "$user"; then
      rm -f "$f"; log "sudo für $user braucht jetzt das Passwort (${f##*/} entfernt)"
    else
      log "WARNUNG: $user hat kein Passwort – sudo bleibt ohne Passwort (im Imager ein Passwort setzen)"
    fi
  done
}

# -- Bootloader: Start nur von der SD-Karte ---------------------------------------------------------------------
BL=unknown                         # ok | open | pending (wirkt nach Neustart) | failed | no_tool | unreadable
CUR_EEPROM=""
# Wert aus der EEPROM-Konfiguration – nur aus Abschnitten, die für diesen Pi gelten (ohne, [all], [pi5] …). Steht der
# Schlüssel in einem anderen Abschnitt ([pi4], [0x…] …), gilt «?»: nicht sicher (write_bootloader räumt das auf).
eeprom_model() {
  case "$(tr -d '\0' < "$R/proc/device-tree/model" 2>/dev/null)" in
    *"Compute Module 5"*) echo cm5 ;; *"Raspberry Pi 5"*) echo pi5 ;;
    *"Compute Module 4"*) echo cm4 ;; *"Raspberry Pi 4"*) echo pi4 ;; *) echo "" ;;
  esac
}
eeprom_get() {
  printf '%s\n' "$2" | awk -v k="$1" -v m="$(eeprom_model)" '
    /^[[:space:]]*\[.*\][[:space:]]*$/ { s = $0; gsub(/[][[:space:]]/, "", s); s = tolower(s); next }
    index($0, k "=") == 1 { v = substr($0, length(k) + 2); gsub(/[[:space:]]/, "", v)
                             val = (s == "" || s == "all" || (m != "" && s == m)) ? tolower(v) : "?" }
    END { print val }'
}
eeprom_pending() { [ -f "$BOOT/pieeprom.upd" ] && [ -f "$BOOT/recovery.bin" ]; }

eeprom_safe() {                    # eeprom_safe EINSTELLUNGEN -> 0, wenn nur von der SD-Karte und ohne Netzwerk-Installation
  # NET_INSTALL_AT_POWER_ON=1 (Standard mancher Images) ginge vor NET_INSTALL_ENABLED=0: darum beide
  [ "$(eeprom_get BOOT_ORDER "$1")" = "$BOOT_ORDER_WANT" ] && [ "$(eeprom_get NET_INSTALL_ENABLED "$1")" = 0 ] &&
    [ "$(eeprom_get NET_INSTALL_AT_POWER_ON "$1")" = 0 ]
}

bootloader_state() {               # setzt BL und CUR_EEPROM, ohne etwas zu ändern
  if ! command -v rpi-eeprom-config >/dev/null; then BL=no_tool; return 0; fi
  CUR_EEPROM=$(rpi-eeprom-config 2>/dev/null) || true
  if [ -z "$CUR_EEPROM" ]; then BL=unreadable; return 0; fi
  if eeprom_safe "$CUR_EEPROM"; then
    BL=ok
    # wartet ein fremdes, unsicheres Update (pieeprom.upd), würde es die Härtung beim Neustart aufheben: neu schreiben
    if eeprom_pending && ! eeprom_safe "$(rpi-eeprom-config "$BOOT/pieeprom.upd" 2>/dev/null)"; then BL=open; fi
  elif eeprom_pending && eeprom_safe "$(rpi-eeprom-config "$BOOT/pieeprom.upd" 2>/dev/null)"; then
    BL=pending                     # unser Update wartet auf den Neustart (ein fremdes wird ersetzt)
  else
    BL=open
  fi
}

write_bootloader() {
  local tmp
  bootloader_state
  [ "$BL" = open ] || return 0
  tmp=$(mktemp)
  # bisherige Einstellungen behalten, nur diese zwei ersetzen – unter [all], damit kein Abschnitt [pi4] o.ä. sie schluckt
  printf '%s\n' "$CUR_EEPROM" | grep -vE '^(BOOT_ORDER|NET_INSTALL_ENABLED|NET_INSTALL_AT_POWER_ON)=' > "$tmp"
  printf '[all]\nBOOT_ORDER=%s\nNET_INSTALL_ENABLED=0\nNET_INSTALL_AT_POWER_ON=0\n' "$BOOT_ORDER_WANT" >> "$tmp"
  if rpi-eeprom-config --apply "$tmp" >/dev/null 2>&1; then
    BL=pending; log "Bootloader: Start nur von der SD-Karte (BOOT_ORDER=$BOOT_ORDER_WANT) – wirkt nach dem nächsten Neustart"
  else
    BL=failed; log "WARNUNG: Bootloader-Einstellung nicht geschrieben (rpi-eeprom-config --apply gescheitert)"
  fi
  rm -f "$tmp"
}

# -- Bluetooth aus -----------------------------------------------------------------------------------------------
bt_config_off() {                  # dtoverlay=disable-bt gilt für diesen Pi: ohne Abschnitt, unter [all] oder [pi5]
  [ -f "$BOOT/config.txt" ] && awk '
    /^[[:space:]]*\[/ { s = tolower($0); gsub(/[[:space:]]/, "", s); on = (s == "[all]" || s == "[pi5]"); next }
    on && /^[[:space:]]*dtoverlay=disable-bt([[:space:]]|$)/ { found = 1 }
    END { exit !found }' on=1 "$BOOT/config.txt"
}

write_bt() {
  if [ -f "$BOOT/config.txt" ] && ! bt_config_off; then
    printf '\n[all]\ndtoverlay=disable-bt\n' >> "$BOOT/config.txt"   # [all]: nicht in einem Abschnitt wie [cm5] landen
    log "Bluetooth: in config.txt abgeschaltet – wirkt nach dem nächsten Neustart"
  fi
  [ -n "$R" ] || systemctl disable --now hciuart.service bluetooth.service >/dev/null 2>&1 || true
}

# -- Keine Anmeldung an der Konsole ------------------------------------------------------------------------------
write_console() {
  local new u changed=""
  new=$(mktemp)
  {
    echo "# FestPOS: keine Anmeldung am Bildschirm (festpos-haertung). Der Hinweistext (/etc/issue, z.B. der"
    echo "# Einrichtungscode) bleibt sichtbar; statt «login» zeigt festpos-haertung --kein-login einen Hinweis."
    echo "[Service]"
    echo "ExecStart="
    echo "ExecStart=-/sbin/agetty --noclear --skip-login --login-program $SELF --login-options --kein-login %I \$TERM"
  } > "$new"
  if ! cmp -s "$new" "$GETTY_DROP"; then
    install -d "${GETTY_DROP%/*}"; install -m 0644 "$new" "$GETTY_DROP"; changed=1
  fi
  printf '# FestPOS: keine weiteren Konsolen (Alt+F2 …) – festpos-haertung\n[Login]\nNAutoVTs=0\nReserveVT=0\n' > "$new"
  if ! cmp -s "$new" "$LOGIND_DROP"; then
    install -d "${LOGIND_DROP%/*}"; install -m 0644 "$new" "$LOGIND_DROP"; changed=1
    # logind liest NAutoVTs nur beim Start: neu starten (laufende Sitzungen bleiben)
    [ -n "$R" ] || systemctl try-restart systemd-logind.service >/dev/null 2>&1 || true
  fi
  rm -f "$new"
  # bei jedem Lauf: weitere Konsolen (Alt+F2 …) und serielle Anmeldungen, die noch laufen, beenden – auch wenn sie
  # schon gesperrt waren (NAutoVTs=0 und mask verhindern nur neue)
  if [ -z "$R" ]; then
    # shellcheck disable=SC2086
    systemctl stop 'getty@tty[2-9].service' $SERIAL_GETTYS >/dev/null 2>&1 || true
  fi
  for u in $SERIAL_GETTYS; do
    [ "$(readlink "$UNITS/$u" 2>/dev/null)" = /dev/null ] && continue
    if [ -n "$R" ]; then install -d "$UNITS"; ln -sfn /dev/null "$UNITS/$u"
    else systemctl mask --now "$u" >/dev/null 2>&1 || true; fi   # --now: eine laufende Anmeldeaufforderung gleich weg
    changed=1
  done
  [ -n "$changed" ] || return 0
  log "Konsole: keine Anmeldung mehr am Bildschirm"
  if [ -z "$R" ]; then               # Anmeldeaufforderung gleich ersetzen – ausser dort ist gerade jemand angemeldet
    systemctl daemon-reload 2>/dev/null || true
    who 2>/dev/null | grep -qw tty1 || systemctl try-restart getty@tty1.service 2>/dev/null || true
  fi
}

console_off() {
  local u
  [ -f "$GETTY_DROP" ] && [ -f "$LOGIND_DROP" ] || return 1
  for u in $SERIAL_GETTYS; do [ "$(readlink "$UNITS/$u" 2>/dev/null)" = /dev/null ] || return 1; done
  if [ -z "$R" ]; then                # und wirklich keine Anmeldung mehr am Laufen
    for u in $SERIAL_GETTYS getty@tty2.service getty@tty3.service getty@tty4.service getty@tty5.service getty@tty6.service; do
      systemctl is-active --quiet "$u" 2>/dev/null && return 1
    done
  fi
  return 0
}

kein_login() {                     # statt «login» an der Konsole
  printf '\nFestPOS: Anmelden am Bildschirm ist abgeschaltet. Zugang für die Technik: SSH mit Schlüssel.\n'
  exec sleep infinity
}

write_state() {
  [ "$BL" = unknown ] && bootloader_state
  install -d "${STATE%/*}"
  printf '{"boot": "%s", "boot_order": "%s", "bt_off": %s, "console_off": %s, "at": %s}\n' "$BL" \
    "$(eeprom_get BOOT_ORDER "$CUR_EEPROM")" "$(bt_config_off && echo true || echo false)" \
    "$(console_off && echo true || echo false)" "$(date +%s)" > "$STATE.neu"
  chmod 0644 "$STATE.neu"; mv -f "$STATE.neu" "$STATE"
}

stand() {
  local user home keys=0 nopw=false
  IFS=: read -r user home <<< "$(first_user)"
  [ -n "$user" ] && keys=$(key_count "$R$home/.ssh/authorized_keys")
  if [ -n "$user" ] && grep -lqsE "^[[:space:]]*${user}[[:space:]].*NOPASSWD" "$R"/etc/sudoers.d/* 2>/dev/null; then nopw=true; fi
  bootloader_state
  printf '{"ssh_keys_only": %s, "user": "%s", "keys": %s, "sudo_without_password": %s, "password_set": %s, ' \
    "$([ -f "$SSHD_DROP" ] && echo true || echo false)" "$user" "$keys" "$nopw" \
    "$([ -n "$user" ] && has_password "$user" && echo true || echo false)"
  printf '"boot": "%s", "bt_off": %s, "console_off": %s}\n' "$BL" "$(bt_config_off && echo true || echo false)" \
    "$(console_off && echo true || echo false)"
}

case "${1:-}" in
  --stand) stand ;;
  --kein-login) kein_login ;;
  '') take_keys; write_sshd; write_sudo; write_bootloader; write_bt; write_console; write_state ;;
  *) echo "Aufruf: festpos-haertung [--stand]" >&2; exit 2 ;;
esac
exit 0
