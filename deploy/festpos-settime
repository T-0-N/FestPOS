#!/usr/bin/python3
"""FestPOS – Systemzeit setzen (läuft als root).

  festpos-settime EPOCH_SEKUNDEN     von Hand (root)
  festpos-settime --anfrage          vom Dienst festpos-settime.path: Aufträge der App ausführen

Die App (Benutzer festpos) darf die Uhr nicht selbst stellen und braucht dafür auch kein sudo mehr
(REV-050: so läuft sie mit NoNewPrivileges). Sie legt pro Auftrag eine Datei «anfrage-<id>» mit
«<id> <epoch>» in /run/festpos/zeit ab; systemd startet dieses Programm, solange dort etwas liegt
(DirectoryNotEmpty). Die Antwort steht in /run/festpos/zeit-ergebnis/<id> (gehört root, die App liest nur).
Optional steht im Auftrag noch die Quelle («<id> <epoch> take»). Nach dem Stellen schreibt es /run/festpos/zeit-stand
(wann, Quelle): Daran sieht die App, dass die Uhr seit dem Start gestellt wurde (T2) – nach einem Neustart ist /run leer.
"""
import fcntl
import json
import os
import re
import shutil
import stat
import struct
import subprocess
import sys
import time

ANFRAGEN = os.environ.get("FESTPOS_ZEIT_DIR", "/run/festpos/zeit")
ERGEBNISSE = os.environ.get("FESTPOS_ZEIT_ERGEBNIS", "/run/festpos/zeit-ergebnis")
STAND = os.environ.get("FESTPOS_ZEIT_STAND", "/run/festpos/zeit-stand")
MIN_EPOCH, MAX_EPOCH = 1735689600, 4102444800          # 2025 … 2100
NAME_RE = re.compile(r"anfrage-([A-Za-z0-9_-]{1,40})")
RTC = "/dev/rtc0"
FAKE_HWCLOCK = "/etc/fake-hwclock.data"
RTC_SET_TIME = 0x4024700A                               # _IOW('p', 0x0a, struct rtc_time), 9 × int


def _run(*cmd: str) -> bool:
    try:
        return subprocess.run(cmd, capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):       # Programm fehlt / hängt: Uhr ist trotzdem gestellt
        return False


def rtc_bytes(epoch: float) -> bytes:
    """struct rtc_time in UTC (Monat 0–11, Jahr ab 1900, Sonntag = 0) – wie hwclock -w."""
    g = time.gmtime(epoch)
    return struct.pack("9i", g.tm_sec, g.tm_min, g.tm_hour, g.tm_mday, g.tm_mon - 1, g.tm_year - 1900,
                       (g.tm_wday + 1) % 7, g.tm_yday - 1, 0)


def rtc_schreiben() -> bool:
    """Systemzeit direkt ins RTC (Pi 5 mit Batterie). Braucht kein hwclock – das fehlt auf Pi OS ohne
    util-linux-extra, dann kam die von den Handys gestellte Zeit nie ins RTC."""
    try:
        fd = os.open(RTC, os.O_WRONLY)
    except OSError:
        return False
    try:
        fcntl.ioctl(fd, RTC_SET_TIME, rtc_bytes(time.time()))
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def stand(quelle: str) -> None:
    """Merken, dass die Uhr seit dem Start gestellt wurde (für die App lesbar, gehört root)."""
    try:
        tmp = STAND + ".neu"
        with open(tmp, "w") as f:
            f.write(json.dumps({"at": int(time.time()), "source": quelle}) + "\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, STAND)
    except OSError:
        pass


def setze(epoch: int, quelle: str = "hand") -> tuple[bool, str]:
    if not MIN_EPOCH <= epoch <= MAX_EPOCH:
        return False, "unplausible Zeit"
    if os.environ.get("FESTPOS_ZEIT_TROCKEN") == "1":      # nur Tests: nichts wirklich stellen
        stand(quelle)
        return True, "Zeit gesetzt (Test)"
    if not _run("date", "-s", f"@{epoch}"):
        return False, "date fehlgeschlagen"
    if os.path.exists(RTC) and not rtc_schreiben():
        _run("hwclock", "-w")                              # Notlösung; fehlt hwclock: egal
    if shutil.which("fake-hwclock") and os.path.exists(FAKE_HWCLOCK):
        # Gibt es die Datei nicht, hält die RTC die Zeit: festpos-node hat sie gelöscht und fake-hwclock abgeschaltet (T16).
        # «force»: auch rückwärts speichern, sonst bliebe eine einmal zu spät gestellte Zeit gespeichert.
        _run("fake-hwclock", "save", "force")
    stand(quelle)
    return True, "Zeit gesetzt: " + time.strftime("%d.%m.%Y %H:%M:%S")


def lies(path: str) -> tuple[int, str] | None:
    """Kleine, normale Datei (kein Symlink) mit «<id> <epoch> [quelle]». Der Inhalt wird nie zurückgemeldet."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > 200:
            return None
        text = os.read(fd, 200).decode("ascii", "replace")
    finally:
        os.close(fd)
    m = re.fullmatch(r"\s*[A-Za-z0-9_-]{1,40}\s+(\d{1,12})(?:\s+([a-z]{1,12}))?\s*", text)
    return (int(m.group(1)), m.group(2) or "app") if m else None


def melde(auftrag: str, ok: bool, text: str) -> None:
    os.makedirs(ERGEBNISSE, mode=0o755, exist_ok=True)
    tmp = os.path.join(ERGEBNISSE, f".{auftrag}.neu")
    with open(tmp, "w") as f:
        f.write(f"{'ok' if ok else 'fehler'} {text}\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(ERGEBNISSE, auftrag))


def aufraeumen() -> None:
    """Alte Antworten (älter als 5 Minuten) löschen – /run ist im Arbeitsspeicher."""
    grenze = time.time() - 300
    try:
        for e in os.scandir(ERGEBNISSE):
            if e.is_file(follow_symlinks=False) and e.stat(follow_symlinks=False).st_mtime < grenze:
                os.unlink(e.path)
    except OSError:
        pass


def anfragen() -> int:
    auftraege = []
    try:
        eintraege = list(os.scandir(ANFRAGEN))
    except OSError:
        return 0
    for e in eintraege:
        m = NAME_RE.fullmatch(e.name)
        inhalt = lies(e.path) if m else None
        if m:
            auftraege.append((e.stat(follow_symlinks=False).st_mtime, m.group(1), inhalt))
        # ALLES entfernen (auch Fremdes), sonst startet systemd den Dienst immer wieder (DirectoryNotEmpty)
        try:
            if e.is_dir(follow_symlinks=False):
                shutil.rmtree(e.path)
            else:
                os.unlink(e.path)
        except OSError:
            pass
    rc = 0
    for _, auftrag, inhalt in sorted(auftraege, key=lambda a: a[:2]):   # ältester zuerst, der neueste gilt zuletzt
        ok, text = setze(*inhalt) if inhalt is not None else (False, "Auftrag unlesbar")
        try:
            melde(auftrag, ok, text)
        except OSError:
            rc = 1
        rc = rc or (0 if ok else 2)
    aufraeumen()
    return rc


def main(argv: list[str]) -> int:
    if argv[1:2] == ["--anfrage"]:
        return anfragen()
    if len(argv) == 2 and argv[1].isdigit():
        ok, text = setze(int(argv[1]))
        print(text, file=sys.stdout if ok else sys.stderr)
        return 0 if ok else 2
    print("Aufruf: festpos-settime EPOCH_SEKUNDEN | --anfrage", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
